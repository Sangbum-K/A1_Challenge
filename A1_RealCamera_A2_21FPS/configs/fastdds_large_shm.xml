<?xml version="1.0" encoding="UTF-8" ?>
<!-- 2 MB Bayer frames need a larger same-host shared-memory segment. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>shm_large</transport_id>
      <type>SHM</type>
      <segment_size>67108864</segment_size>
      <maxMessageSize>65500</maxMessageSize>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>udp_large</transport_id>
      <type>UDPv4</type>
      <sendBufferSize>33554432</sendBufferSize>
      <receiveBufferSize>33554432</receiveBufferSize>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="a1_a2_large_frames" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>shm_large</transport_id>
        <transport_id>udp_large</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
