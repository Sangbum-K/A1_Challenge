<?xml version="1.0"?>
<package format="2">
  <name>morai_bridge</name>
  <version>0.0.0</version>
  <description>The morai_bridge package</description>

  <!-- One maintainer tag required, multiple allowed, one person per tag -->
  <maintainer email="yuseungna@hanyang.ac.kr">Yuseung.Na</maintainer>

  <!-- One license tag required, multiple allowed, one license per tag -->
  <license>TODO</license>

  <!-- The *depend tags are used to specify dependencies -->
  <!-- Dependencies can be catkin packages or system dependencies -->
  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>roscpp</build_depend>
  <build_depend>autohyu_msgs</build_depend>
  <build_depend>morai_msgs</build_depend>
  <build_depend>cv_bridge</build_depend>
  <build_depend>image_transport</build_depend>
  <build_depend>morai_cpp_networks</build_depend>

  <build_export_depend>roscpp</build_export_depend>
  <build_export_depend>autohyu_msgs</build_export_depend>
  <build_export_depend>morai_msgs</build_export_depend>
  <build_export_depend>cv_bridge</build_export_depend>
  <build_export_depend>image_transport</build_export_depend>
  <build_export_depend>morai_cpp_networks</build_export_depend>

  <exec_depend>roscpp</exec_depend>
  <exec_depend>autohyu_msgs</exec_depend>
  <exec_depend>morai_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>morai_cpp_networks</exec_depend>

  <depend>libopencv-dev</depend>

  <!-- The export tag contains other, unspecified, tags -->
  <export>
    <!-- Other tools can request additional information be placed here -->

  </export>
</package>
