<!-- -->
<launch>
  <!-- Received from simulator launch -->
  <arg name="location" default="sangam" /> <!-- kcity, pangyo, daegu, sangam -->
  <arg name="proj_mode" default="utm" /> <!-- local_cartesian, utm — A1 sangam 작동 세팅 -->

  <arg name="ref_lat" default="37.22932413" />
  <arg name="ref_lon" default="126.77329780" />
  <!-- <arg name="ref_lat" default="" /> -->
  <!-- <arg name="ref_lon" default="" /> -->

  <arg name="use_control_mode_button" default="false" /> <!-- GUI(tk): headless 에선 끔. display 있으면 true -->

  <!-- multicar: 차량별 ROS namespace. 빈 값(기본)이면 ns 없이 root 에서 기동 → 단일차 기존 동작.
       Car1 등 지정 시 노드들의 상대토픽(app/..., raw_img_app/...) 이 /Car1/app/... 로 resolve.
       (moraibridge 노드는 모두 nh_ relative advertise/subscribe 이므로 namespace 가 그대로 먹음).
       roslaunch 의 <group ns=""> 는 에러 → ns 적용/미적용 두 갈래를 if/unless 로 분기.
       NOTE: simulation.ini(포트) 는 launch 와 무관 — IniParser 가 cwd(getenv PWD)/config/simulation.ini
       를 읽음. 차별 포트는 런처가 차마다 다른 cwd 에서 roslaunch 하여 해결(run_multicar.sh). -->
  <arg name="car_ns" default="" />
  <arg name="ns_on" default="$(eval car_ns != '')" /> <!-- car_ns 비어있으면 false -->

  <rosparam file="$(find morai_bridge)/../../config/rosparam_system.yaml" command="load"/>

  <!-- ====== ns 적용 (car_ns 지정 시) ====== -->
  <group if="$(arg ns_on)" ns="$(arg car_ns)">
    <node pkg="morai_bridge" type="morai_vehicle_driver" name="vehicle_driver" output="screen" respawn="true">
      <param name="location" value="$(arg location)"/>
      <param name="proj_mode" value="$(arg proj_mode)"/>
      <param name="ref_lat" value="$(arg ref_lat)"/>
      <param name="ref_lon" value="$(arg ref_lon)"/>
    </node>
    <node pkg="morai_bridge" type="morai_vehicle_control" name="vehicle_control" output="screen" respawn="true"/>
    <group if="$(arg use_control_mode_button)">
      <node pkg="morai_bridge" type="control_mode_button.py" name="control_mode_button" output="screen" />
    </group>
    <node pkg="morai_bridge" type="morai_camera_driver" name="camera_driver" output="screen" respawn="true"/>
  </group>

  <!-- ====== ns 미적용 (단일차, 기존 동작) ====== -->
  <group unless="$(arg ns_on)">
    <node pkg="morai_bridge" type="morai_vehicle_driver" name="vehicle_driver" output="screen" respawn="true">
      <param name="location" value="$(arg location)"/>
      <param name="proj_mode" value="$(arg proj_mode)"/>
      <param name="ref_lat" value="$(arg ref_lat)"/>
      <param name="ref_lon" value="$(arg ref_lon)"/>
    </node>
    <node pkg="morai_bridge" type="morai_vehicle_control" name="vehicle_control" output="screen" respawn="true"/>
    <group if="$(arg use_control_mode_button)">
      <node pkg="morai_bridge" type="control_mode_button.py" name="control_mode_button" output="screen" />
    </group>
    <node pkg="morai_bridge" type="morai_camera_driver" name="camera_driver" output="screen" respawn="true"/>
  </group>
</launch>
