; ===========================================================================
; SCC multi-car closed-loop master config
; ---------------------------------------------------------------------------
; run_multicar.sh 가 이 파일을 파싱해 [CarN] 마다 한 세트
;   (moraibridge 1개 + closed_loop 제어기 1개) 를 namespace·포트 충돌 없이 기동.
;
; 각 [CarN] 항목 키 → moraibridge/config/simulation.ini 실제 키 매핑:
;   namespace          → ROS group ns (/CarN/...). closed_loop CAR_NS 와 동일.
;   prefix             → 제어기 모드(모델) 식별자. run_multicar.sh 의 case 문이 env 로 변환.
;   udp_src_ip         → [MoraiBridge] udp_source_ip            (MORAI 시뮬 IP, 보통 공통)
;   udp_dest_ip        → [MoraiBridge] udp_destination_ip       (이 머신 IP, 보통 공통)
;   vehicle_state_port → [MoraiVehicleDriver] udp_vehicle_info_source_port
;                        + udp_vehicle_info_destination_port    (sim → us, 차별)
;   camera_port        → [MoraiCameraDriver]  udp_camera_driver_source_ports
;                        + udp_camera_driver_destination_ports  (sim → us, 차별; SCC 는 camera_1 단일)
;   control_port       → [MoraiVehicleControl] udp_ego_ctl_source_port
;                        + udp_ego_ctl_destination_port         (us → sim, 차별)
;   object_port        → [MoraiObjectDriver]  udp_object_source_port
;                        + udp_object_destination_port          (sim → us, 차별)
;                        ※ morai_bridge.launch 의 3 노드(driver/control/camera)는 object 미사용.
;                          object_driver 노드 추가 시를 위해 키만 보존(현재는 ini 에만 기록).
;
; 포트 권장 대역 (simulation.ini 주석과 일치):
;   19000-19099 Camera (sim→us) · 9900-9999 Vehicle/Object (sim↔us) · 9000-9099 Control (us→sim)
; 차마다 마지막 자리만 다르게 (CarN → ...N) 하면 충돌 없이 직관적.
;
; ref_lat/ref_lon/location/proj_mode 는 차 공통이므로 [Common] 에서 1회 지정.
;   (vehicle_driver 노드는 /vehicle_driver/ref_lat 절대경로 rosparam 을 읽는데, group ns 하에선
;    이 lookup 이 빗나가 simulation.ini [MoraiSimLocation] fallback 으로 떨어짐 → ini 에 채워야 함.
;    run_multicar.sh 가 [Common] 값을 차별 ini 의 [MoraiSimLocation] 에 치환해 넣음.)
;
; ---------------------------------------------------------------------------
; prefix → 실제 로드 ckpt (closed_loop_node.py env 로직 기준, 2026-05-26 검증):
;   qualifier : iy MODEL_VARIANT=B  → data/ckpts/iy_v25k_B4_gttc_accgate_best_loss.pt   [실존]
;   acc_gate  : prof635 MODEL_ACC=1 → f_2 = prof635_side_predvrel_ttc.pt (ACC_F2_CKPT 기본) [실존]
;               gate/i2_mem = a2_v7b_d128_alpha075 (MODEL_A2_V6_CKPT 기본) [실존]
;               5f vrel a_2 = a2_gate_hardneg_5f.pt (ACC_A2_MF5F_CKPT override) [실존]
;   baseline  : prof635 기본       → f_2 = prof635_side_distbrake_v1.pt (PROF635_CKPT 기본) [실존]
;   cmain     : iy MODEL_VARIANT=C → data/ckpts/iy_v25c2_main_v0301only_best_loss.pt        [실존]
;   scc_p{1-5}_f654 : prof635 + SCC profile side(scc_p{N}_side.pt) + main #654. gate=내부 gate_head(obj+vrel 2sigmoid).
;   scc_p{1-5}_f656 : 위 + MAIN_CKPT=main_prof656.pth override.  (DELTA_MODE=brake_only, F2_DELTA_SCALE=1.0)
;       · p1=공격(s_min 3) ~ p5=보수(s_min 18). publish_test_weights.sh 가 scc_p{N}_side.pt 게시(학습 완료 profile 만 실존).
;       · 예) [Car5] prefix=scc_p3_f654  → 중간 profile, 654 main.  [Car6] prefix=scc_p3_f656 → 656 main.
;       · e2e 단일 .pt(A1E2EModel-scc, 규정 §1.1 본선)는 closed_loop wire 별도 — 현 분리경로는 테스트용.
;   공통 backbone/main : seg_pretrain_fx640_v3_backbone.pt + main_prof654.pth [실존]
; bin80 (80-bin a_2) 모델은 아직 미지원: closed_loop_node.py 가 a_2 를 40-token/n_ch=7
;   전제로 하드코딩(adaptive_avg_pool2d→40, ACC_BIN_LO/HI=16/25). 80bin 로딩은 별도 통합 필요 →
;   closed_loop 80bin 통합 후 [CarN] 으로 추가할 것.
; ===========================================================================

[Common]
udp_src_ip  = 10.0.0.10
udp_dest_ip = 10.0.0.20
proj_mode   = utm
; ---- 트랙/라인 선택: 이 두 줄이면 끝 (location/ref 자동) ----
;   track = sangam(상암) | speedway(용인)   → MORAI sim location/ref_lat/ref_lon 자동 매핑
;   map   = mild(안정)   | high(공격)        → 같은 트랙 내 라인 난이도
track       = sangam
map         = mild
; (선택) location/ref 를 직접 쓰면 track 자동매핑보다 우선 — 보통 불필요.
;   상암 : location=sangam   ref_lat=37.58336692  ref_lon=126.88224248
;   용인 : location=speedway ref_lat=37.29695047  ref_lon=127.21141031
; location  = sangam
; ref_lat   = 37.58336692
; ref_lon   = 126.88224248

[Car1]
prefix             = qualifier        ; 예선 모드 (iy v25k-B4, distbrake)
namespace          = Car1
vehicle_state_port = 9090
camera_port        = 9001
control_port       = 9091
object_port        = 7071
; map              = high             ; (선택) 이 차만 다른 라인. 없으면 [Common] map 사용.
; track            = speedway         ; (선택) per-car track override. 보통 [Common] 로 통일.